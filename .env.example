# =============================================================================
# Agentic Research & Decision Platform — environment template
# Copy to .env and fill in. Everything runs with zero keys when FAKE_LLM=true
# (deterministic offline provider for tests/CI).
# =============================================================================

# --- App -------------------------------------------------------------------
ENVIRONMENT=development
API_KEY=dev-key-change-me          # required as X-API-Key on all /v1 requests
LOG_LEVEL=INFO
LOG_JSON=false

# --- LLM (LiteLLM model strings: provider is part of the string) ------------
# Free & powerful default: Google Gemini free tier  -> https://aistudio.google.com/apikey
# Alternatives:
#   Groq (free, very fast):        groq/llama-3.3-70b-versatile      + GROQ_API_KEY
#   OpenAI:                        openai/gpt-4o-mini                + OPENAI_API_KEY
#   Anthropic:                     anthropic/claude-sonnet-4-5       + ANTHROPIC_API_KEY
#   Local Ollama:                  ollama/llama3.1:8b                + OLLAMA_API_BASE=http://localhost:11434
FAKE_LLM=false
MODEL=gemini/gemini-2.5-flash
JUDGE_MODEL=gemini/gemini-2.5-flash
# Fallbacks rotated in on rate limits / transient provider errors (comma-separated).
# Example: LLM_FALLBACK_MODELS=groq/llama-3.3-70b-versatile,openai/gpt-4o-mini
LLM_FALLBACK_MODELS=
LLM_RETRY_BACKOFF_SECONDS=2         # exponential base between attempts (honors Retry-After)
# Truncate evidence bodies to N chars inside LLM prompts (full text kept in DB/UI)
PROMPT_EVIDENCE_MAX_CHARS=500
EMBEDDING_MODEL=gemini/gemini-embedding-001
TEMPERATURE=0.2
MAX_COMPLETION_TOKENS=4096
LLM_TIMEOUT_SECONDS=90
MAX_REPAIR_RETRIES=2

GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_BASE=

# --- Web research -------------------------------------------------------------
# Free tier: https://tavily.com (1000 searches/mo). Leave empty to skip web agent.
TAVILY_API_KEY=

# --- Graph policy --------------------------------------------------------------
MAX_REVISIONS=2                    # synthesizer<->critic loop ceiling
JUDGE_PASS_THRESHOLD=7.0           # avg rubric score needed to pass
JUDGE_DIMENSION_FLOOR=5.0          # no single rubric dimension below this
MAX_EVIDENCE_PER_AGENT=6

# --- Infrastructure (docker-compose defaults) ----------------------------------
DATABASE_URL=postgresql+asyncpg://platform:platform@localhost:5433/platform
DB_POOL_SIZE=10                     # postgres connection pool (per process)
DB_MAX_OVERFLOW=20
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_base
VECTOR_SIZE=768                    # gemini/text-embedding-004 = 768; openai = 1536

# --- Execution -----------------------------------------------------------------
# inline  = missions run inside the API process (simple dev setup)
# workers = API enqueues only; run `make worker` / the compose worker service.
#           Horizontally scalable, crash-safe via lease requeue.
EXECUTION_MODE=inline
WORKER_CONCURRENCY=4               # parallel jobs per worker process
JOB_LEASE_SECONDS=900              # claim lease; expired leases get requeued

# --- Tool tuning ---------------------------------------------------------------
WEB_RESULTS_PER_QUERY=5
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
